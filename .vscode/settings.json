{
    // VsCode Action Buttons配置 - 在状态栏添加快捷按钮
    "actionButtons": {
        "defaultColor": "#ffffff",
        "loadNpmCommands": false,
        "reloadButton": null,
        "commands": [
            {
                "cwd": "${workspaceFolder}",
                "name": "$(circuit-board) Build",
                "color": "#4CAF50",
                "singleInstance": true,
                "command": "$env:PATH='C:\\SysGCC\\arm-eabi\\bin;'+$env:PATH; C:\\msys64\\usr\\bin\\make.exe all -j4",
                "tooltip": "编译STM32项目"
            },
            {
                "cwd": "${workspaceFolder}",
                "name": "$(zap) Flash",
                "color": "#FF9800",
                "singleInstance": true,
                "command": "C:\\Users\\liuxi\\AppData\\Local\\VisualGDB\\EmbeddedDebugPackages\\com.sysprogs.arm.openocd\\bin\\openocd.exe -f interface/cmsis-dap.cfg -c \"transport select swd\" -c \"adapter speed 3000\" -f target/stm32f1x.cfg -c \"init\" -c \"reset init\" -c \"flash write_image erase VisualGDB/Debug/NewGyroscope.elf\" -c \"reset\" -c \"shutdown\"",
                "tooltip": "烧录到STM32"
            },
            {
                "cwd": "${workspaceFolder}",
                "name": "$(rocket) Build+Flash",
                "color": "#2196F3",
                "singleInstance": true,
                "command": "$env:PATH='C:\\SysGCC\\arm-eabi\\bin;'+$env:PATH; C:\\msys64\\usr\\bin\\make.exe all -j4; if($?) { C:\\Users\\liuxi\\AppData\\Local\\VisualGDB\\EmbeddedDebugPackages\\com.sysprogs.arm.openocd\\bin\\openocd.exe -f interface/cmsis-dap.cfg -c \"transport select swd\" -c \"adapter speed 3000\" -f target/stm32f1x.cfg -c \"init\" -c \"reset init\" -c \"flash write_image erase VisualGDB/Debug/NewGyroscope.elf\" -c \"reset\" -c \"shutdown\" }",
                "tooltip": "编译并烧录"
            },
            {
                "cwd": "${workspaceFolder}",
                "name": "$(trash) Clean",
                "color": "#F44336",
                "singleInstance": true,
                "command": "Remove-Item -Path VisualGDB\\Debug\\*.o,VisualGDB\\Debug\\*.elf,VisualGDB\\Debug\\*.bin,VisualGDB\\Debug\\*.hex,VisualGDB\\Debug\\*.map,VisualGDB\\Debug\\*.dep -Force -ErrorAction SilentlyContinue",
                "tooltip": "清理编译输出"
            }
        ]
    },
    
    // C/C++配置
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    
    // 文件关联
    "files.associations": {
        "*.h": "c",
        "*.c": "c"
    },
    
    // 排除不需要的文件
    "files.exclude": {
        "**/.git": true,
        "**/.vs": true,
        "**/.visualgdb": true,
        "**/VisualGDB/Debug/*.o": true,
        "**/VisualGDB/Debug/*.dep": true
    }
}
